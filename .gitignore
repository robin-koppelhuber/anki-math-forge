__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
vendor/
node_modules/

# crop working files (--out dirs); the ledger keeps geometry, not pictures
.crops-*/
.tx-*/
# the configured work_dir: crops, page renders, scratch LaTeX
.forge/

# a local `.env`, if your shell loads one; .env.example lists what it may set
.env

# Every source but the Cookbook, and the cards written from them. What a
# reader needs is one worked example: the Cookbook is freely distributed, its
# ledger is the evidence behind the numbers in docs/ROADMAP.md, and its 108
# cards are what the screenshots show. Everything else on the shelf is
# somebody's private reading of somebody else's book, and a shelf is not a
# demonstration -- the second source proves nothing the first one did not.
sources/*
!sources/matrix-cookbook/
cards/*
!cards/matrix-cookbook/

# Cached text layers of the source documents themselves, written by `extract`
# and `zotero` and regenerated on demand. Somebody else's book; not ours to
# redistribute.
sources/*/text.md
sources/*/text-*.md

# Scratch dumps from `--json` runs.
*.tmp.json
