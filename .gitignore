__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
vendor/
node_modules/

# crop working files (--out dirs); the ledger keeps geometry, not pictures
.crops-*/
.tx-*/
# the configured work_dir: crops, page renders, scratch LaTeX
.forge/

# a local `.env`, if your shell loads one; .env.example lists what it may set
.env

# Cached text layers of the source documents themselves, written by `extract`
# and `zotero` and regenerated on demand. Somebody else's book; not ours to
# redistribute. `sources/matrix-cookbook/.gitignore` said this for one source
# and the Zotero path never inherited it.
sources/*/text.md
sources/*/text-*.md

# Scratch dumps from `--json` runs.
*.tmp.json
