# Zotero, for the import pass (ROADMAP.md §2). Copy to `.env`, which is
# gitignored. Note: `.mcp.json` expands ${VAR} from the environment, not from
# this file, so export what you need in the shell you launch Claude from.

# --- zotero (local, stdio) -------------------------------------------------
# Read-only, no key, no network. Needs Zotero 7 running with the local API on
# (Settings > Advanced). Already set in `.mcp.json`.
ZOTERO_LOCAL=

# --- zotero-remote (MetaMCP, http) -----------------------------------------
# The only value you have to set. URL is hardcoded in `.mcp.json`;
# ZOTERO_API_KEY / ZOTERO_LIBRARY_ID belong on the server, not here.
ZOTERO_MCP_API_KEY=

# --- web API, only if the local one is not enough ---------------------------
# Group libraries, or no Zotero on this machine.
# Key and numeric userID: https://www.zotero.org/settings/security#applications
# ZOTERO_API_KEY=
# ZOTERO_LIBRARY_ID=
# ZOTERO_LIBRARY_TYPE=user      # "group" for a group library

# --- optional ---------------------------------------------------------------
# ZOTERO_WEBDAV_URL=
# ZOTERO_WEBDAV_USERNAME=
# ZOTERO_WEBDAV_PASSWORD=
# ZOTERO_MCP_TOOLSETS=          # extra tool groups; each one costs context
# ZOTERO_DB_PATH=               # non-default zotero.sqlite
