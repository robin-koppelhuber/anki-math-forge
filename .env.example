# Environment overrides. Copy to `.env` if your shell loads one; the tool reads
# these from the environment, not from a file, and every one of them has a
# working default. Nothing here is a credential: AnkiConnect listens on
# localhost without one, and Zotero's local API is read-only and unauthenticated.

# Where AnkiConnect is listening. Overrides `[anki] url` in forge.toml.
# ANKI_CONNECT_URL=http://127.0.0.1:8765

# Where Zotero's local API is. Only for a non-default port.
# ZOTERO_API_URL=http://127.0.0.1:23119

# The KaTeX build `check` shells out to. Found under node_modules/ by default,
# and `check` says which parser ran either way.
# ANKI_FORGE_KATEX_JS=
